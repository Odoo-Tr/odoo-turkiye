<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.tr" model="res.country">
        <field name="enforce_cities" eval="True"/>
        <field name="state_required" eval="True"/>
        <!-- PTT style: "34710 Kadıköy/İstanbul" -->
        <field name="address_format" eval="'%(street)s\n%(street2)s\n%(zip)s %(city)s/%(state_name)s\n%(country_name)s'"/>
    </record>
</odoo>
