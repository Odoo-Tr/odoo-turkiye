<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_amount_in_words" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tr_amount_in_words</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                <setting id="tr_amount_in_words" string="Amount in words (Turkish)"
                         help="Adds the line &quot;Yalnız: ... Türk Lirası ... Kuruş&quot; under the total on the invoice report.">
                    <field name="tr_show_amount_in_words"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
