<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_amount_in_words" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tr_amount_in_words</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='main_currency_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="tr_amount_in_words">
                    <div class="o_setting_left_pane">
                        <field name="tr_show_amount_in_words"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="tr_show_amount_in_words" string="Amount in words (Turkish)"/>
                        <div class="text-muted">
                            Adds the line "Yalnız: ... Türk Lirası ... Kuruş" under the total on the invoice report.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
