<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_bank_form_eft" model="ir.ui.view">
        <field name="name">res.bank.form.l10n_tr_banka</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <field name="bic" position="after">
                <field name="l10n_tr_eft_code"/>
            </field>
        </field>
    </record>

    <record id="view_res_bank_tree_eft" model="ir.ui.view">
        <field name="name">res.bank.list.l10n_tr_banka</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_tree"/>
        <field name="arch" type="xml">
            <field name="bic" position="after">
                <field name="l10n_tr_eft_code" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
