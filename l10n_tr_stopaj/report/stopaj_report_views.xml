<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_tr_stopaj_report_view_list" model="ir.ui.view">
        <field name="name">l10n_tr.stopaj.report.list</field>
        <field name="model">l10n_tr.stopaj.report</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="partner_vat" optional="show"/>
                <field name="stopaj_type"/>
                <field name="direction" optional="hide"/>
                <field name="tax_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="base_amount" sum="Total"/>
                <field name="stopaj_amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="l10n_tr_stopaj_report_view_pivot" model="ir.ui.view">
        <field name="name">l10n_tr.stopaj.report.pivot</field>
        <field name="model">l10n_tr.stopaj.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date" interval="month" type="row"/>
                <field name="stopaj_type" type="col"/>
                <field name="base_amount" type="measure"/>
                <field name="stopaj_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_tr_stopaj_report_view_search" model="ir.ui.view">
        <field name="name">l10n_tr.stopaj.report.search</field>
        <field name="model">l10n_tr.stopaj.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_id"/>
                <filter name="withheld_by_us" string="Withheld by us" domain="[('direction', '=', 'purchase')]"/>
                <filter name="withheld_by_customers" string="Withheld by customers" domain="[('direction', '=', 'sale')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_type" string="Withholding Type" context="{'group_by': 'stopaj_type'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_tr_stopaj_report_action" model="ir.actions.act_window">
        <field name="name">Income Tax Withholding</field>
        <field name="res_model">l10n_tr.stopaj.report</field>
        <field name="view_mode">tree,pivot</field>
        <field name="context">{'search_default_withheld_by_us': 1, 'search_default_group_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No withholding yet</p>
            <p>Add a "WHT" tax to a vendor bill for self-employment fees or rent; posted entries appear here, ready for the withholding tax return.</p>
        </field>
    </record>

    <menuitem id="menu_l10n_tr_stopaj_report"
              action="l10n_tr_stopaj_report_action"
              parent="account.account_reports_management_menu"
              sequence="40"/>
</odoo>
