<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tcmb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tr_tcmb_rates</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='main_currency_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="tcmb_rates">
                    <div class="o_setting_left_pane">
                        <field name="tcmb_auto_update"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="tcmb_auto_update" string="TCMB exchange rates"/>
                        <div class="text-muted">
                            Fetch rates from the indicative rates bulletin of the Central Bank of the Republic of Türkiye.
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="tcmb_rate_type" class="col-lg-5 o_light_label"/>
                                <field name="tcmb_rate_type" class="col-lg-7"/>
                            </div>
                            <div class="mt8">
                                <field name="tcmb_next_day" class="oe_inline"/>
                                <label for="tcmb_next_day" class="o_light_label ms-2"/>
                            </div>
                            <div class="row mt8" attrs="{'invisible': [('tcmb_last_update', '=', False)]}">
                                <label for="tcmb_last_update" class="col-lg-5 o_light_label"/>
                                <field name="tcmb_last_update" class="col-lg-7"/>
                            </div>
                            <div class="mt8">
                                <button name="action_tcmb_update_rates" type="object"
                                        string="Update rates now" class="btn-link p-0" icon="fa-refresh"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
