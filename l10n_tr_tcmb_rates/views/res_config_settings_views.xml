<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tcmb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tr_tcmb_rates</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                <setting id="tcmb_rates" string="TCMB döviz kurları"
                         help="Kurları TCMB gösterge kurları bülteninden alır.">
                    <field name="tcmb_auto_update"/>
                    <div class="content-group mt-2">
                        <div class="row">
                            <label for="tcmb_rate_type" class="col-lg-5 o_light_label"/>
                            <field name="tcmb_rate_type"/>
                        </div>
                        <div class="row">
                            <label for="tcmb_next_day" class="col-lg-5 o_light_label"/>
                            <field name="tcmb_next_day"/>
                        </div>
                        <div class="row">
                            <label for="tcmb_last_update" class="col-lg-5 o_light_label"/>
                            <field name="tcmb_last_update"/>
                        </div>
                        <button name="action_tcmb_update_rates" type="object"
                                string="Kurları şimdi güncelle" icon="oi-arrow-right" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
