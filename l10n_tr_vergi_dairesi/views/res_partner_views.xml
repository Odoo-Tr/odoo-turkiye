<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_tax_office" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_tr_vergi_dairesi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="l10n_tr_tax_office_id" invisible="country_code != 'TR'"
                       domain="state_id and [('state_id', '=', state_id)] or []"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_company_form_tax_office" model="ir.ui.view">
        <field name="name">res.company.form.l10n_tr_vergi_dairesi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="l10n_tr_country_code" invisible="1"/>
                <field name="l10n_tr_tax_office_id" invisible="l10n_tr_country_code != 'TR'" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
