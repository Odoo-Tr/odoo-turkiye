<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_annual_leave" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_tr_yillik_izin</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="birthday" position="after">
                <field name="l10n_tr_seniority_date"/>
                <field name="l10n_tr_underground"/>
                <field name="l10n_tr_service_years" invisible="not l10n_tr_seniority_date"/>
                <label for="l10n_tr_annual_leave_days" invisible="not l10n_tr_seniority_date"/>
                <div class="o_row" invisible="not l10n_tr_seniority_date">
                    <field name="l10n_tr_annual_leave_days" class="oe_inline"/>
                    <span>days</span>
                    <button name="action_l10n_tr_allocate_annual_leave" type="object" string="Allocate"
                            class="btn-link" groups="hr_holidays.group_hr_holidays_user"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
